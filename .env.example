# Copy this file to `.env` and replace the placeholders with your own values.
# In development the app loads `.env`; in any other environment these must come
# from the real environment (container, host, CI).

NODE_ENV=development

# Application
APPLICATION_PORT=4000
GRAPHQL_PREFIX=/graphql
ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL (>= 15). POSTGRES_USER/PASSWORD/DATABASE also configure the
# container in docker-compose.yml; POSTGRES_URI is what the app and Prisma read.
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=teastream
POSTGRES_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}

# Redis. REDIS_PASSWORD also configures the container in docker-compose.yml.
REDIS_USER=default
REDIS_PASSWORD=123456
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URI=redis://${REDIS_USER}:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# Sessions and cookies
COOKIE_SECRET=change-me
SESSION_SECRET=change-me-too
SESSION_NAME=session
SESSION_DOMAIN=localhost
SESSION_MAX_AGE_DAYS=30
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_FOLDER=sessions:

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_LOGIN=noreply@example.com
MAIL_PASSWORD=your-smtp-password

# S3-compatible storage for avatars
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=teastream
